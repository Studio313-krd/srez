# Merge into the existing TLS virtual host; use your actual certificate paths.
server {
    listen 443 ssl;
    server_name reports.example.ru;
    ssl_certificate /etc/letsencrypt/live/reports.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reports.example.ru/privkey.pem;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
server {
    listen 80;
    server_name reports.example.ru;
    return 301 https://$host$request_uri;
}
